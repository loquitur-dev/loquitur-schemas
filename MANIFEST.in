include README.md
include LICENSE-APACHE
include LICENSE-MIT
include NOTICE
recursive-include src/loquitur/schemas/data *.json *.md
recursive-include src/loquitur/schemas/types *.d.ts
recursive-include src/loquitur/schemas/compatibility_baselines *.json
