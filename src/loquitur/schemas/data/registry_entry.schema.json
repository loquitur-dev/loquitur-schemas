{
  "$id": "https://schemas.loquitur.dev/v1/registry_entry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "example": {
    "anchor": null,
    "anchored_at": null,
    "asset_type": "fund_nav",
    "disclosure_profile": "issuer_controlled_bundle",
    "effective_at": "2026-04-29T00:00:00Z",
    "issued_at": "2026-04-29T12:00:00Z",
    "issuer_id": "issuer_synthetic_demo",
    "issuer_key_id": "demo-key-2",
    "manifest_hash": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "object_type": "registry_entry",
    "policy_id": "loquitur.fund_nav.v1",
    "policy_version": "1.0.0",
    "privacy_classification": "public_commitment",
    "reason_code_catalog_version": "loquitur.reason_codes.v1",
    "reason_codes": [
      "CONFLICTING_EVIDENCE_DETECTED"
    ],
    "receipt_hash": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
    "receipt_id": "vr_synthetic_demo_0001",
    "registry_entry_id": "reg_synthetic_demo_0001",
    "schema_version": "v1",
    "signature": null,
    "subject_ref_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "verdict": "REVIEW",
    "workflow": "fund_nav_update"
  },
  "properties": {
    "anchor": {
      "additionalProperties": false,
      "properties": {
        "anchor_reference": {
          "minLength": 1,
          "type": "string"
        },
        "method": {
          "description": "The anchoring method: an identifier, a value of the registered vocabulary anchoring_method (verification-vocabularies.md section 5). No check reads it in this version, and an unknown method has no effect on a run (anchor-commitment.md section 6).",
          "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "system": {
          "description": "The system that carries the anchoring record, such as a CAIP-2 chain id for a blockchain transaction, the time-stamping authority for an RFC 3161 token, or the origin of a transparency log. Its lexical form is not fixed in this version (anchor-commitment.md section 6).",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "method",
        "system",
        "anchor_reference"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "anchored_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
      "type": [
        "string",
        "null"
      ]
    },
    "asset_type": {
      "description": "An asset type: an identifier, a value of the registered vocabulary asset_type (verification-vocabularies.md section 5). Any well-formed identifier satisfies the contract; whether the reader's vocabulary holds it is judged after the contract, and an unknown value is a question for review, not a refusal (section 7).",
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "disclosure_profile": {
      "enum": [
        "minimal_public",
        "issuer_controlled_bundle",
        "partner_authorized_bundle"
      ],
      "type": "string"
    },
    "effective_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
      "type": [
        "string",
        "null"
      ]
    },
    "issued_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
      "type": "string"
    },
    "issuer_id": {
      "pattern": "^issuer_[A-Za-z0-9_-]{3,128}$",
      "type": "string"
    },
    "issuer_key_id": {
      "minLength": 1,
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "object_type": {
      "const": "registry_entry",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9_.-]+)?$",
      "type": "string"
    },
    "privacy_classification": {
      "enum": [
        "public_commitment"
      ],
      "type": "string"
    },
    "reason_code_catalog_version": {
      "const": "loquitur.reason_codes.v1",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "enum": [
          "AUTHORIZATION_ISSUER_KEY_EXPIRED",
          "AUTHORIZATION_ISSUER_KEY_NOT_YET_EFFECTIVE",
          "AUTHORIZATION_ISSUER_KEY_REVOKED",
          "AUTHORIZATION_ISSUER_KEY_SUSPENDED",
          "AUTHORIZATION_ISSUER_NOT_RECOGNISED",
          "AUTHORIZATION_SCOPE_MISMATCH",
          "AUTHORIZATION_SIGNATURE_NOT_VERIFIED",
          "AUTHORIZATION_SIGNING_METHOD_UNSUPPORTED",
          "AUTHORIZATION_TRUST_MATERIAL_OUTSIDE_VALIDITY_WINDOW",
          "AUTHORIZATION_TRUST_REGISTRY_AMBIGUOUS_KEY",
          "AUTHORIZATION_VERIFIED",
          "BUNDLE_EXTRA_FILES",
          "COMPLETENESS_OFFLINE_CHECKS_SKIPPED",
          "COMPLETENESS_OFFLINE_MATERIAL_MISSING",
          "COMPLETENESS_OFFLINE_MISSING_CANONICAL_INPUT",
          "COMPLETENESS_OFFLINE_MISSING_MANIFEST",
          "CONFLICTING_EVIDENCE_DETECTED",
          "FRESHNESS_OK",
          "FRESHNESS_P1_TIMESTAMP_OOW",
          "FRESHNESS_WARNING",
          "INTEGRITY_CHECK_FAILED",
          "INTEGRITY_OFFLINE_CANONICALIZATION_FAILED",
          "INTEGRITY_OFFLINE_ENVELOPE_LINKS_MISMATCH",
          "INTEGRITY_OFFLINE_ENVELOPE_SHA_MISMATCH",
          "INTEGRITY_OFFLINE_EXTRA_FILES_STRICT",
          "INTEGRITY_OFFLINE_FAIL",
          "INTEGRITY_OFFLINE_INPUT_HASH_MISMATCH",
          "INTEGRITY_OFFLINE_MANIFEST_FILE_MISMATCH",
          "INTEGRITY_OFFLINE_MANIFEST_SHA_MISMATCH",
          "INTEGRITY_OFFLINE_SCHEMA_INVALID",
          "INTEGRITY_OK",
          "MARK_ASOF_UNPARSEABLE",
          "MARK_FAR_OUTSIDE_RANGE",
          "MARK_NEAR_BOUNDARY",
          "MARK_OFFSET_FROM_MIDPOINT",
          "MARK_OUTSIDE_RANGE",
          "MARK_STALE",
          "MATERIAL_CHANGE_DETECTED",
          "METHOD_BINDING_MISSING",
          "MISSING_MARK_FIELDS",
          "MISSING_REQUIRED_INPUTS",
          "NEEDS_REVIEW",
          "OFFLINE_CANONICAL_INPUT_MISSING",
          "OFFLINE_INPUT_HASH_NOT_VERIFIED",
          "OFFLINE_MANIFEST_MISSING",
          "OFFLINE_MATERIAL_MISSING",
          "OFFLINE_REPLAY_FAILED",
          "OFFLINE_REPLAY_REVIEW",
          "OFFLINE_REPLAY_SKIPPED",
          "OFFLINE_REPLAY_WARN",
          "P1_TIMESTAMP_OUT_OF_WINDOW",
          "POLICY_BUNDLE_EXTRA_FILES",
          "REQUIRED_CLAIMS_PRESENT",
          "REQUIRED_EVIDENCE_PRESENT",
          "UNSUPPORTED_KEY_CLAIM",
          "VOCABULARY_VALUE_INVALID",
          "VOCABULARY_VALUE_UNKNOWN"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "receipt_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^vr_[A-Za-z0-9_-]{8,128}$",
      "type": "string"
    },
    "registry_entry_id": {
      "pattern": "^reg_[A-Za-z0-9_-]{8,128}$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "signature": {
      "description": "Issuer signature, in the signing-envelope v2 shape. This version defines no earlier shape: a signature object without payload_id and payload_version breaks the entry's contract.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "description": "Domain-separated signing-envelope v2 signature metadata.",
          "properties": {
            "algorithm": {
              "description": "Signature algorithm identifier. Any well-formed identifier is admitted; the verifier's own allowlist decides, at the signature step, whether it is supported (UNSUPPORTED_SIGNATURE_ALGORITHM).",
              "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "key_id": {
              "minLength": 1,
              "type": "string"
            },
            "payload_id": {
              "const": "registry_entry_signing_payload_v2",
              "type": "string"
            },
            "payload_version": {
              "const": 2,
              "type": "integer"
            },
            "signature": {
              "description": "ECDSA over secp256k1 in IEEE P1363 compact form: r and s concatenated, 64 bytes as 128 lowercase hex characters, low-S enforced. A length bound alone would make the single character \"x\" a schema-valid secp256k1 signature.",
              "pattern": "^[a-f0-9]{128}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "payload_id",
            "payload_version",
            "signature"
          ],
          "title": "RegistryEntrySignatureV2",
          "type": "object"
        }
      ]
    },
    "subject_ref_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARN",
        "REVIEW",
        "FAIL"
      ],
      "type": "string"
    },
    "workflow": {
      "description": "A workflow: an identifier, a value of the registered vocabulary workflow (verification-vocabularies.md section 5). Any well-formed identifier satisfies the contract; whether the reader's vocabulary holds it is judged after the contract, and an unknown value is a question for review, not a refusal (section 7).",
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
      "type": "string"
    }
  },
  "required": [
    "object_type",
    "schema_version",
    "registry_entry_id",
    "receipt_id",
    "issuer_id",
    "issuer_key_id",
    "asset_type",
    "workflow",
    "subject_ref_hash",
    "manifest_hash",
    "receipt_hash",
    "policy_id",
    "policy_version",
    "reason_code_catalog_version",
    "verdict",
    "reason_codes",
    "issued_at",
    "privacy_classification",
    "disclosure_profile"
  ],
  "title": "Loquitur Registry Entry",
  "type": "object"
}
