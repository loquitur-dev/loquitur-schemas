{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.loquitur.dev/v1/verification_summary.schema.json",
  "title": "Loquitur Verification Summary",
  "type": "object",
  "required": [
    "object_type",
    "schema_version",
    "bundle_id",
    "status",
    "reason_codes",
    "reason_code_vocabulary_version"
  ],
  "properties": {
    "object_type": {
      "type": "string",
      "const": "verification_summary"
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "v2"
      ]
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_type": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
      "description": "An asset type: an identifier, a value of the registered vocabulary asset_type (verification-vocabularies.md section 5), or null."
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "review",
        "fail"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "AUTHORIZATION_ISSUER_KEY_EXPIRED",
          "AUTHORIZATION_ISSUER_KEY_NOT_YET_EFFECTIVE",
          "AUTHORIZATION_ISSUER_KEY_REVOKED",
          "AUTHORIZATION_ISSUER_KEY_SUSPENDED",
          "AUTHORIZATION_ISSUER_NOT_RECOGNISED",
          "AUTHORIZATION_SCOPE_MISMATCH",
          "AUTHORIZATION_SIGNATURE_NOT_VERIFIED",
          "AUTHORIZATION_SIGNING_METHOD_UNSUPPORTED",
          "AUTHORIZATION_TRUST_MATERIAL_OUTSIDE_VALIDITY_WINDOW",
          "AUTHORIZATION_TRUST_REGISTRY_AMBIGUOUS_KEY",
          "AUTHORIZATION_VERIFIED",
          "BUNDLE_EXTRA_FILES",
          "COMPLETENESS_OFFLINE_CHECKS_SKIPPED",
          "COMPLETENESS_OFFLINE_MATERIAL_MISSING",
          "COMPLETENESS_OFFLINE_MISSING_CANONICAL_INPUT",
          "COMPLETENESS_OFFLINE_MISSING_MANIFEST",
          "CONFLICTING_EVIDENCE_DETECTED",
          "FRESHNESS_OK",
          "FRESHNESS_P1_TIMESTAMP_OOW",
          "FRESHNESS_WARNING",
          "INTEGRITY_CHECK_FAILED",
          "INTEGRITY_OFFLINE_CANONICALIZATION_FAILED",
          "INTEGRITY_OFFLINE_ENVELOPE_LINKS_MISMATCH",
          "INTEGRITY_OFFLINE_ENVELOPE_SHA_MISMATCH",
          "INTEGRITY_OFFLINE_EXTRA_FILES_STRICT",
          "INTEGRITY_OFFLINE_FAIL",
          "INTEGRITY_OFFLINE_INPUT_HASH_MISMATCH",
          "INTEGRITY_OFFLINE_MANIFEST_FILE_MISMATCH",
          "INTEGRITY_OFFLINE_MANIFEST_SHA_MISMATCH",
          "INTEGRITY_OFFLINE_SCHEMA_INVALID",
          "INTEGRITY_OK",
          "MARK_ASOF_UNPARSEABLE",
          "MARK_FAR_OUTSIDE_RANGE",
          "MARK_NEAR_BOUNDARY",
          "MARK_OFFSET_FROM_MIDPOINT",
          "MARK_OUTSIDE_RANGE",
          "MARK_STALE",
          "MATERIAL_CHANGE_DETECTED",
          "METHOD_BINDING_MISSING",
          "MISSING_MARK_FIELDS",
          "MISSING_REQUIRED_INPUTS",
          "NEEDS_REVIEW",
          "OFFLINE_CANONICAL_INPUT_MISSING",
          "OFFLINE_INPUT_HASH_NOT_VERIFIED",
          "OFFLINE_MANIFEST_MISSING",
          "OFFLINE_MATERIAL_MISSING",
          "OFFLINE_REPLAY_FAILED",
          "OFFLINE_REPLAY_REVIEW",
          "OFFLINE_REPLAY_SKIPPED",
          "OFFLINE_REPLAY_WARN",
          "P1_TIMESTAMP_OUT_OF_WINDOW",
          "POLICY_BUNDLE_EXTRA_FILES",
          "REQUIRED_CLAIMS_PRESENT",
          "REQUIRED_EVIDENCE_PRESENT",
          "UNSUPPORTED_KEY_CLAIM",
          "VOCABULARY_VALUE_INVALID",
          "VOCABULARY_VALUE_UNKNOWN"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "reason_context": {
      "description": "LCP-0008: the facts that make an actionable code actionable. A bare code says a key expired; it does not say which key or when. Every field but `code` is optional on purpose, because a producer able to name only the code must still be able to report at all. `code` is typed as a plain string here rather than carrying a second copy of the enum above: the vocabulary is checked against the reason-code catalog by loquitur.schemas.verdict_grounds, and a second hand-maintained copy of a vocabulary is the shape that produced the signing-prefix drift corrected in LCP-0006.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "A reason code present in the catalog at the declared reason_code_vocabulary_version."
          },
          "subject": {
            "type": "string",
            "description": "What the code is about: the key id, the document class, the file, the claim."
          },
          "observed": {
            "type": "string",
            "description": "The value actually found."
          },
          "expected": {
            "type": "string",
            "description": "The value the rule required."
          },
          "window": {
            "type": "string",
            "description": "The validity or freshness window the evaluation was made against."
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "policy_pack_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy_checks": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "evaluation_clock_iso": {
          "description": "RFC 3339 instant, and the one place in this package where a numeric offset is accepted alongside Z: this is a trace of the clock a policy was evaluated against, reported by the evaluator, not a value any commitment is computed over. The signed surfaces, registry_entry and trust_registry, stay Z-only. A pattern of the form ...T.*(Z|...) would accept 2026-13-45Tnot a time at allZ, so each part of the instant is bounded.",
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      },
      "additionalProperties": true
    },
    "policy_surface": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "freshness_posture": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "required_claims_status": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "supported_vs_declared_summary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "key_checks": {
      "type": [
        "array",
        "object",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "additionalProperties": true
    },
    "key_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "reason_code_vocabulary_version": {
      "type": "string",
      "const": "loquitur.reason_codes.v1"
    }
  },
  "additionalProperties": false,
  "example": {
    "asset_id": "asset-demo-001",
    "asset_type": "property",
    "bundle_id": "bundle_property_demo_2026_0002",
    "freshness_posture": {
      "status": "warning",
      "stale_document_classes": [
        "occupancy_report"
      ]
    },
    "key_checks": [
      {
        "check_id": "integrity",
        "status": "pass"
      }
    ],
    "key_metrics": [
      {
        "claim_type": "external_mark",
        "support_status": "supported"
      }
    ],
    "object_type": "verification_summary",
    "policy_id": "example.v1",
    "policy_pack_sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "policy_surface": {
      "material_change_detected": false
    },
    "policy_version": 1,
    "reason_code_vocabulary_version": "loquitur.reason_codes.v1",
    "reason_codes": [
      "FRESHNESS_WARNING"
    ],
    "required_claims_status": {
      "required_total": 2,
      "missing_count": 0
    },
    "schema_version": "v2",
    "status": "warning",
    "supported_vs_declared_summary": {
      "supported_count": 2,
      "declared_only_count": 0,
      "conflicted_count": 0
    },
    "warnings": [
      "Stale document classes: occupancy_report"
    ]
  }
}
