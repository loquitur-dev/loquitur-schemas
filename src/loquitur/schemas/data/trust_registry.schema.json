  "properties": {
    "effective_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_asset_types": {
            "items": {
              "description": "An asset type the key is authorized for: an identifier (verification-vocabularies.md section 5). Scope compares values exactly, whether or not the verifier's vocabulary holds them, and no value stands for every asset type (trust-registry-authorization.md section 11).",
              "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "allowed_workflows": {
            "items": {
              "description": "A workflow the key is authorized for: an identifier (verification-vocabularies.md section 5). Scope compares values exactly, whether or not the verifier's vocabulary holds them, and no value stands for every workflow (trust-registry-authorization.md section 11).",
              "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "effective_from": {
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
            "type": "string"
          },
          "expires_at": {
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
            "type": "string"
          },
          "issuer_display_name": {
            "minLength": 1,
            "type": "string"
          },
          "issuer_id": {
            "pattern": "^issuer_[A-Za-z0-9_-]{3,128}$",
            "type": "string"
          },
          "issuer_key_id": {
            "minLength": 1,
            "type": "string"
          },
          "key_type": {
            "description": "Key type identifier. Any well-formed identifier is admitted; the verifier's allowlist decides at the signature step whether the pair of algorithm and key type is supported.",
            "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "notes": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "public_key_hex": {
            "description": "Public key as lowercase hexadecimal, 1 to 512 bytes. Its form for the key type is judged at the signature step: for secp256k1, an uncompressed SEC1 point 04 || X || Y with X and Y below p, on the curve.",
            "pattern": "^([a-f0-9]{2}){1,512}$",
            "type": "string"
          },
          "revocation_reason": {
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "revoked_at": {
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "active",
              "suspended",
              "revoked"
            ],
            "type": "string"
          }
        },
        "required": [
          "issuer_id",
          "issuer_display_name",
          "issuer_key_id",
          "key_type",
          "public_key_hex",
          "status",
          "effective_from",
          "expires_at",
          "allowed_asset_types",
          "allowed_workflows"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "expires_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
      "type": "string"
    },
    "issued_at": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$",
      "type": "string"
    },
    "object_type": {
      "const": "trust_registry",
      "type": "string"
    },
    "registry_operator_id": {
      "pattern": "^operator_[A-Za-z0-9_-]{3,128}$",
      "type": "string"
    },
    "registry_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9_.-]+)?$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        "v1"
      ],
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "description": "Root signature algorithm identifier. Any well-formed identifier is admitted; root authentication decides whether it is supported.",
          "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "key_id": {
          "minLength": 1,
          "type": "string"
        },
        "signature": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "signature"
