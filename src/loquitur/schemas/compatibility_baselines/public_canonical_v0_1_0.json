            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "receipt_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^vr_[A-Za-z0-9_-]{8,128}$",
          "type": "string"
        },
        "registry_entry_id": {
          "pattern": "^reg_[A-Za-z0-9_-]{8,128}$",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "v1"
          ],
          "type": "string"
        },
        "signature": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "key_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "payload_id": {
                  "const": "registry_entry_signing_payload_v2",
                  "type": "string"
                },
                "payload_version": {
                  "const": 2,
                  "type": "integer"
                },
                "signature": {
                  "pattern": "^[a-f0-9]{128}$",
                  "type": "string"
                }
              },
              "required": [
                "algorithm",
                "key_id",
                "payload_id",
                "payload_version",
                "signature"
              ],
              "type": "object"
            }
          ]
        },
        "subject_ref_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "PASS",
            "WARN",
            "REVIEW",
            "FAIL"
          ],
          "type": "string"
        },
        "workflow": {
          "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "asset_type",
        "disclosure_profile",
        "issued_at",
        "issuer_id",
        "issuer_key_id",
        "manifest_hash",
        "object_type",
        "policy_id",
        "policy_version",
        "privacy_classification",
        "reason_code_catalog_version",
        "reason_codes",
        "receipt_hash",
        "receipt_id",
        "registry_entry_id",
        "schema_version",
        "subject_ref_hash",
        "verdict",
        "workflow"
      ],
      "type": "object"
    },
    "trust_registry.schema.json": {
