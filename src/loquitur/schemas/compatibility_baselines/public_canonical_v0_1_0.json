              },
              "issuer_id": {
                "pattern": "^issuer_[A-Za-z0-9_-]{3,128}$",
                "type": "string"
              },
              "issuer_key_id": {
                "minLength": 1,
                "type": "string"
              },
              "key_type": {
                "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
                "type": "string"
              },
