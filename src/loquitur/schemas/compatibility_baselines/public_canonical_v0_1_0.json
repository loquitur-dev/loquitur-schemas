    "registry_entry.schema.json": {
      "$id": "https://schemas.loquitur.dev/v1/registry_entry.schema.json",
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "additionalProperties": false,
          "properties": {
            "anchor_reference": {
